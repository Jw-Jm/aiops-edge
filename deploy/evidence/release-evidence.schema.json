{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "git_commit", "working_tree_digest", "commands", "checks", "images", "release_materials"],
  "properties": {
    "schema_version": {"const": 1},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "working_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "exit_code", "output_sha256"]}},
    "checks": {"type": "object", "required": ["deployment_contract", "production_architecture", "helm_lint", "unit_tests"], "additionalProperties": {"type": "string", "enum": ["pass", "fail", "unverified"]}}
  },
  "additionalProperties": true
}

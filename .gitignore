# =============================================================================
# AIOps 平台项目 .gitignore
# =============================================================================

# 外部参考副本（仅阅读对标，绝不入库）
/ongrid-ref/

# 前端构建产物
node_modules/
dist/
.next/
coverage/
*.tsbuildinfo

# Go 构建产物
*.exe
*.out
/bin/
/tmp/
# query-api 本地编译产物（Mach-O arm64，勿入库）
ai-apm-query-go/api
ai-apm-ingest-go/ingest
# Stage D/C 新独立服务本地编译产物（勿入库）
ai-action-executor/ai-action-executor
ai-llm-egress-proxy/ai-llm-egress-proxy

# Python 缓存
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/

# 环境与密钥（绝不入库）
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# 重建备份目录（含 secrets override / deployment 备份 / identity 记录，含敏感值，绝不入库）
/rebuild-backup/

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.swp

# 日志
*.log
deploy/helm/aiops/charts/

# Slim 工具目录 + codemap 归档（工具生成，非交付）
.slim/
codemap-archive/

# Go 编译二进制（不同路径，勿入库）
ai-event-collector/ai-event-collector
deploy/tools/clickhouse-migrator/clickhouse-migrator
deploy/tools/object-store-bootstrap/object-store-bootstrap

# 隔离 worktree 目录
/.worktrees/

# playwright-cli 临时 snapshot 文件（测试产物，不入库）
.playwright-cli/

# Codex/本地会话运行产物（不属于发布候选，不删除用户已有文件）
*:memory:.ses

# subagent-driven-development 流程产物（brief/report/ledger/diff，可重建，不入库）
.superpowers/

# 测试/审计截图（不入库）
*.png
postlogin

# 本地下载的运维二进制（随镜像离线打包，不入库）
ai-apm-query-go/docker/

# 前端 v2 旧版备份（redesign 后不再引用，不入库）
observability-frontend/src_legacy_v2/


# playwright-cli 测试快照（.yaml，不入库）
observability-frontend/*.yaml

# 编译产物（Mach-O arm64 本地构建）
ai-apm-ingest-go/loadgen
ai-apm-query-go/query-api
# 测试截图产物（不入库）
gui-test-screenshots/

# deepwork 进度文件
.slim/deepwork/

# 离线依赖缓存（本地构建复用，不入库）
deploy/offline/

# 本地默认部署的递增版本状态（不进入版本库）
/.deploy-version

# =============================================================================
# AIOps 平台项目 .gitignore
# =============================================================================

# 外部参考副本（仅阅读对标，绝不入库）
/ongrid-ref/

# 前端构建产物
node_modules/
dist/
.next/
coverage/
*.tsbuildinfo

# Go 构建产物
*.exe
*.out
/bin/
/tmp/

# Python 缓存
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/

# 环境与密钥（绝不入库）
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.swp

# 日志
*.log
deploy/helm/aiops/charts/

# 隔离 worktree 目录
/.worktrees/

# playwright-cli 临时 snapshot 文件（测试产物，不入库）
.playwright-cli/

